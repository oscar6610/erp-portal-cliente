# Plantilla de variables de entorno.
# Copiar a ".env" y completar los valores reales. El archivo .env NO se sube
# al repositorio (está en .gitignore).
#
# Generar la clave secreta con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

# --- Django ---
DJANGO_SECRET_KEY=reemplazar-por-una-clave-generada
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# Usar "mysql" para el prototipo definitivo y "sqlite" solo para pruebas rápidas.
DB_ENGINE=mysql

DB_NAME=erp_portal_cliente
DB_USER=erp_portal
DB_PASSWORD=reemplazar-por-la-contrasena-local
DB_HOST=127.0.0.1
DB_PORT=3306
